ness_date":"2019-08-23","purpose":"ORDERS ON APPLICATIONS -22","judge":"","cause_list_type":"DAILY CAUSE LIST"},{"hearing_date":"2019-08-23","business_date":"2019-08-22","purpose":"ORDERS ON APPLICATIONS -22","judge":"","cause_list_type":"DAILY CAUSE LIST"},{"hearing_date":"2019-08-22","business_date":"2019-08-21","purpose":"ORDERS ON APPLICATIONS -22","judge":"","cause_list_type":"DAILY CAUSE LIST"},{"hearing_date":"2019-08-21","business_date":"2019-08-20","purpose":"ORDERS ON APPLICATIONS -22","judge":"","cause_list_type":"DAILY CAUSE LIST"},{"hearing_date":"2019-08-02","business_date":"2019-07-12","purpose":"Order on Applications (Time Barred Cases) -255","judge":"","cause_list_type":"DAILY CAUSE LIST"}],"orders":[{"date":"2019-07-12","judge":"Hon'ble Mr. Justice Ramesh Ranganathan,Hon'ble Mr. Justice Alok Kumar Verma","kind":"order","text":"WPSB No.305 of 2019 \nHon’ble Ramesh Ranganathan, C.J.\nHon’ble Alok Kumar Verma, J.\nMr. Bhagwat Mehra, learned Advocate for the \npetitioner. \nAdmit. \nMr. Paresh Tripathi, learned Chief Standing \nCounsel takes notices on behalf of State of \nUttarakhand/respondent Nos.1 to 3. \nMr. Manoj Kumar, learned Standing Counsel takes \nnotice on behalf of respondent No.5. \nLearned counsel for the petitioner, is permitted to \ntake out notice on the sixth respondent by dasti besides \nnormal mode of service and file proof of service within \nthree weeks. \nPost the Interlocutory Application after three \nweeks. \n(Alok Kumar Verma, J.) (Ramesh Ranganathan, CJ.) \n 12.07.2019 \nSanjay "},{"date":"2019-11-02","judge":"Hon'ble Mr. Justice Ramesh Ranganathan,Hon'ble Mr. Justice Alok Kumar Verma","kind":"order","text":"Miscellaneous Application (IA No. 10875 of 2019)\nIn\nWPSB No. 305 of 2019\nHon’ble Ramesh Ranganathan, C.J. \nHon’ble Alok Kumar Verma, J.\nMr. Bhagwat Mehra, learned counsel for the \npetitioner.\nMr. B.S. Parihar, learned Standing Counsel for the \nState of Uttarakhand/ respondent nos. 1 to 3.\nMr. Manoj Kumar, learned Standing Counsel for \nUnion of India/ respondent no. 4.\nMrs. Bina Pande, learned Standing Counsel for the \nState of Uttar Pradesh/ respondent no. 5.\nMr. Alok Mahra, learned counsel for respondent no. \n6.\nCounter affidavit filed on behalf of respondent no. 6\nis taken on record. The miscellaneous application, made \ntherefor, stands disposed of. \nMr. Manoj Kumar, learned counsel for the Union of \nIndia, Mr. B.S. Parihar , learned Standing Counsel for the \nState of Uttarakhand and Mrs. Bina Pande, learned \nStanding Counsel for the State of Uttar Pradesh request \ntwo weeks’ time for filing counter affidavit. \nPost this matter on 18.11.2019.\n(Alok Kumar Verma, J.) (Ramesh Ranganathan, C.J.) 02.11.2019 Navin"},{"date":"2020-12-02","judge":"Hon'ble Mr. Justice Ravi Malimath,Hon'ble Mr. Justice Ravindra Maithani","kind":"order","text":"WPSB No. 305 of 2019\nHon’ble Ravi Malimath, A.C.J.\nHon’ble Ravindra Maithani, J.\nShri Bhagwat Mehra, learned counsel for \nthe petitioner.\nShri Anil K. Bisht, learned additional chief \nstanding counsel for the State.\nShri Gopal K. Verma, learned standing \ncounsel for the State of U.P.\nShri Manoj Kumar, learned counsel \nappearing for respondent no.4.\nThe delay in filing the counter affidavit \nis condoned. The delay condonation \napplication (CLMA No. 15352 of 2019) is \ndisposed off. Counter affidavit is taken on \nrecord.\nMisc. application (IA No. 15104 of \n2019) along with short counter affidavit is \ntaken on record.\nThree weeks’ time is granted to the \npetitioner to file rejoinder affidavit, if any.\n(Ravindra Maithani,J.) (Ravi Malimath) \n02.12.2020 A.C.J. \n 02.12.2020\nN.P"}]}